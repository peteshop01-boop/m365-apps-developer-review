      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "policyDecisionId",
        "policyDecisionSha256",
        "contextId",
        "performanceYear",
        "quarter",
        "periodStart",
        "periodEnd",
        "outputAsOf",
        "contextSha256",
        "scopeVersion",
        "scopeSourceArtifactSha256",
        "scopeSha256",
        "scopeMemberCount",
        "scopeMemberSetSha256",
        "scopeSelectionCheckpoint",
        "targetSelectionVersion",
        "targetSelectionSha256",
        "weightingVersion",
        "weightingSha256",
        "boardScoringPolicySha256",
        "resultSetVersion",
        "resultManifestSha256",
        "resultSelectionSha256",
        "snapshotBinding",
        "unpublishedBatchSha256",
        "ledgerVersion",
        "ledgerSha256",
        "ledgerSourceArtifactSha256",
        "ledgerEntryCount",
        "ledgerEntrySetSha256",
        "ledgerCheckpoint",
        "ledgerCompleteThrough",
        "acceptanceEvidenceReference",
        "acceptanceEvidenceSha256"
      ],
      "properties": {
