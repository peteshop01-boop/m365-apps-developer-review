        },
        "outputAsOf": {
          "$ref": "#/$defs/instant"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "removalLedger": {
          "$ref": "#/$defs/ledger"
        }
      }
    },
