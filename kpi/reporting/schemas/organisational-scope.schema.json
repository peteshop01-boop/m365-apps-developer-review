        },
        "resultSelectionSha256": {
          "$ref": "#/$defs/hash"
        },
        "snapshotBinding": {
          "anyOf": [
            {
              "$ref": "#/$defs/snapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "unpublishedBatchSha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
