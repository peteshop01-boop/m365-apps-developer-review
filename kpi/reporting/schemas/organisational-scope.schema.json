        "approvedBy",
        "approvalReference",
        "approvalEvidenceSha256",
        "approvedAt",
        "reasonCode",
        "reason",
        "effectiveFrom",
        "effectiveTo",
        "recordedAt"
      ],
      "properties": {
        "decisionId": {
          "$ref": "#/$defs/reference"
        },
        "decisionVersion": {
          "$ref": "#/$defs/version"
        },
        "supersedesDecisionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "kpiId": {
          "$ref": "#/$defs/reference"
        },
        "kpiVersionKey": {
          "$ref": "#/$defs/reference"
        },
        "performanceYear": {
          "$ref": "#/$defs/year"
        },
        "quarter": {
          "$ref": "#/$defs/quarter"
        },
        "scopeVersion": {
          "$ref": "#/$defs/reference"
        },
        "decisionKind": {
          "const": "RemoveFromScope"
        },
        "approvedBy": {
          "const": "Sponsor"
        },
        "approvalReference": {
          "$ref": "#/$defs/reference"
        },
        "approvalEvidenceSha256": {
          "$ref": "#/$defs/hash"
        },
        "approvedAt": {
          "$ref": "#/$defs/instant"
        },
        "reasonCode": {
          "$ref": "#/$defs/reference"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        },
        "effectiveFrom": {
          "$ref": "#/$defs/instant"
        },
        "effectiveTo": {
          "anyOf": [
            {
              "$ref": "#/$defs/instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "recordedAt": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledgerVersion",
        "checkpointId",
        "selectedAsOf",
        "sourceArtifactSha256",
        "completeThrough",
        "complete",
        "entryCount",
        "canonicalEntrySetSha256",
        "scopeVersion",
        "performanceYear",
        "quarter",
        "decisions"
      ],
      "properties": {
        "ledgerVersion": {
          "$ref": "#/$defs/reference"
        },
        "checkpointId": {
          "$ref": "#/$defs/reference"
        },
        "selectedAsOf": {
          "$ref": "#/$defs/instant"
        },
        "sourceArtifactSha256": {
          "$ref": "#/$defs/hash"
        },
        "completeThrough": {
          "$ref": "#/$defs/instant"
