          "$ref": "#/$defs/hash"
        },
        "scopeVersion": {
          "$ref": "#/$defs/reference"
        },
        "performanceYear": {
          "$ref": "#/$defs/year"
        },
        "quarter": {
          "$ref": "#/$defs/quarter"
        },
        "decisions": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/decision"
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "policyDecisionId",
        "policyDecisionSha256",
        "contextId",
        "performanceYear",
        "quarter",
        "periodStart",
        "periodEnd",
        "outputAsOf",
        "scope",
        "selection",
        "removalLedger"
      ],
      "properties": {
        "contractVersion": {
          "const": "KCF-ORG-SCOPE-001"
        },
        "policyDecisionId": {
          "const": "M169-CHG-001"
        },
        "policyDecisionSha256": {
          "$ref": "#/$defs/hash"
        },
        "contextId": {
          "$ref": "#/$defs/reference"
        },
        "performanceYear": {
