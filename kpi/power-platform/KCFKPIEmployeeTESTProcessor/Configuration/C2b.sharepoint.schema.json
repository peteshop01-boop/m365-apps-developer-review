  "permissionContracts": {
    "PrivateProcessorOnly": "Exact list ACL contains only injected processor and controlled admin principals; positive processor/admin and negative ordinary employee/manager enumeration/read/write tests are required.",
    "CommandSubmitterCreateOnly": "Injected submitters have create-only list permission and cannot enumerate/read/edit/delete; processor/admin retain control and Author readback is required.",
    "ProcessorOwnedReceiptActorRead": "List remains processor-owned/private; each receipt grants only the injected actor Read and processor/admin control, with negative non-actor and edit/delete tests.",
    "EmployeeContainerInheritance": "Injected processor/admin Full Control and current employee/manager Read are reconciled at PersonKey container; stale principals are revoked and canonical children inherit."
