  "aclProvisioningContract": {
    "requiredRoleSemantics": ["FullControl", "Read", "CreateOnly"],
    "roleDefinitionIdsMustBeDistinct": true,
    "requiredPrincipalBindings": ["Processor", "ControlledAdmin", "CommandSubmitter", "ReceiptActor", "EmployeeContainerActor", "NegativeProof", "RollbackAdmin"],
